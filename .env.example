# Copy to python/.env and fill in. Never commit the real file.

# ── RPC endpoints ─────────────────────────────
# Comma-separated, priority-ordered. The bot starts on the first entry, retries
# it once on a transport fault, then rotates down the list. It sticks to
# whichever endpoint answers rather than re-probing the head on every call.
# Put a keyed endpoint first — free public nodes rate-limit and IP-block.
BASE_RPC_URLS=https://base-mainnet.g.alchemy.com/v2/<KEY>,https://mainnet.base.org,https://base.drpc.org,https://base.meowrpc.com

# Legacy single-endpoint form. Still honoured: used as the whole list when
# BASE_RPC_URLS is absent, or appended as a last-resort fallback when both are
# set. Prefer BASE_RPC_URLS above.
BASE_RPC_URL=https://mainnet.base.org

# ── Wallet ────────────────────────────────────
# Hot wallet only. Holds working capital, not the stack — every buy is swept to
# the cold wallet immediately after the swap.
EVM_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── Telegram ──────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
